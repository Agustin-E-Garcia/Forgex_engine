in vec3 fragWorldPos;
in vec3 fragNormal;

void main()
{
    vec3 normal = normalize(fragNormal);

    vec3 sunDir = normalize(vec3(1.0, 3.0, 1.0));
    float ambient = 0.2;
    float sunDiffuse = max(dot(normal, sunDir), 0.0);
    vec3 lighting = vec3(ambient + sunDiffuse * 0.5);

    for (int i = 0; i < pointLightCount; i++)
    {
        vec3 toLight = lightData[i].pos - fragWorldPos;
        float dist = length(toLight);
        vec3 lightDir = toLight / dist;

        float attenuation = clamp(1.0 - (dist / lightData[i].radius), 0.0, 1.0);
        attenuation *= attenuation;

        float diffuse = max(dot(normal, lightDir), 0.0);
        lighting += lightData[i].color * lightData[i].intensity * diffuse * attenuation;
    }

    FragColor = vec4(albedo * lighting, 1.0);
}
