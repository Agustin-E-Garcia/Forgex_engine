in vec3 normal;
in vec3 fragPos;
in vec2 texCoords;

vec3 CalculateDirectionalLight(vec3 norm, vec3 cameraDir)
{
    vec3 result = vec3(0.0);
    for(int i = 0; i < directionalLightCount; i++)
    {
        // diffuse lighting
        vec3 lightDir = normalize(-vec3(directionalLights[i].direction));
        float diffuseStrenght = max(dot(norm, lightDir), 0.0);
        vec3 diffuse = vec3(directionalLights[i].color) * diffuseStrenght * vec3(texture(material.diffuseMap, texCoords)) * material.diffuse;

        // specular lighting
        vec3 reflection = reflect(-lightDir, norm);
        float specularStrenght = pow(max(dot(reflection, cameraDir), 0.0), material.shininess * 128);
        vec3 specular = vec3(directionalLights[i].color) * (specularStrenght * material.specular);

        result += diffuse + specular;
    }

    return result;
}

vec3 CalculatePointLight(vec3 norm, vec3 cameraDir)
{
    vec3 result = vec3(0.0);
    for(int i = 0; i < pointLightCount; i++)
    {
        float distance = length(pointLights[i].position - fragPos);
        float attenuation = 1.0 / (pointLights[i].constant + pointLights[i].linear * distance + pointLights[i].quadratic * (distance * distance));

        // diffuse lighting
        vec3 lightDir = normalize(pointLights[i].position - fragPos);
        float diffuseStrenght = max(dot(norm, lightDir), 0.0);
        vec3 diffuse = pointLights[i].color * diffuseStrenght * vec3(texture(material.diffuseMap, texCoords)) * material.diffuse;

        // specular lighting
        vec3 reflection = reflect(-lightDir, norm);
        float specularStrenght = pow(max(dot(reflection, cameraDir), 0.0), material.shininess * 128);
        vec3 specular = vec3(pointLights[i].color) * (specularStrenght * material.specular);

        diffuse *= attenuation;
        specular *= attenuation;

        result += diffuse + specular;
    }
    return result;
}

vec3 CalculateSpotLight(vec3 norm, vec3 cameraDir)
{
    vec3 result = vec3(0.0);
    for(int i = 0; i < spotLightCount; i++)
    {
        vec3 lightDir = normalize(vec3(spotLights[i].position) - fragPos);
        float theta = dot(lightDir, normalize(-spotLights[i].direction));
        float epsilon = spotLights[i].cutOff - spotLights[i].outerCutOff;
        float intensity = clamp((theta - spotLights[i].outerCutOff) / epsilon, 0.0, 1.0);

        if(theta > spotLights[i].outerCutOff)
        {
            // diffuse lighting
            float diffuseStrenght = max(dot(norm, lightDir), 0.0);
            vec3 diffuse = vec3(spotLights[i].color) * diffuseStrenght * vec3(texture(material.diffuseMap, texCoords)) * material.diffuse;

            // specular lighting
            vec3 reflection = reflect(-lightDir, norm);
            float specularStrenght = pow(max(dot(reflection, cameraDir), 0.0), material.shininess * 128);
            vec3 specular = vec3(spotLights[i].color) * (specularStrenght * material.specular);

            diffuse *= intensity;
            specular *= intensity;

            result += diffuse + specular;
        }
    }
    return result;
}

vec3 CalculateLighting()
{
    vec3 ambient = vec3(ambientColor) * vec3(texture(material.diffuseMap, texCoords));
    vec3 final = ambient;

    vec3 norm = normalize(normal);
    vec3 cameraDir = normalize(vec3(cameraPosition) - fragPos);

    final += CalculateDirectionalLight(norm, cameraDir);
    final += CalculatePointLight(norm, cameraDir);
    final += CalculateSpotLight(norm, cameraDir);

    return final;
}

void main()
{
    vec3 result = CalculateLighting();
    FragColor = vec4(result, 1.0);
}
