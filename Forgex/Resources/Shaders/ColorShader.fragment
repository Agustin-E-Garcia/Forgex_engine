#version 330 core
in vec3 fragNormal;
out vec4 FragColor;

void main()
{
    vec3 lightDir = normalize(vec3(1.0, 3.0, 1.0));
    vec3 color = vec3(0.2, 0.8, 0.2);

    float ambient = 0.2;
    float diffuse = max(dot(fragNormal, lightDir), 0.0);

    FragColor = vec4(color * (ambient + diffuse), 1.0);
}
