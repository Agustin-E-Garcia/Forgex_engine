#version 330 core
layout (location = 0) in vec3 aPos;
layout (location = 1) in vec3 aNormal;

out vec3 fragNormal;
out vec3 fragAlbedo;

uniform mat4 model;
uniform mat4 view;
uniform mat4 projection;
uniform vec3 albedo;

void main()
{
    gl_Position = projection * view * model * vec4(aPos, 1.0);
    fragNormal = aNormal;
    fragAlbedo = albedo;
}
